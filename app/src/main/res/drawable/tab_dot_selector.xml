        <layer-list>
            <item
                android:width="9dp"
                android:height="9dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/main_color" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:width="9dp"
                android:height="9dp"
                android:gravity="center">
                <shape android:shape="oval">
