<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivSheetImage"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/product_title"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvSheetTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvSheetPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/main_color"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvSheetColorLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_color"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="15sp"
            android:visibility="gone"
            android:layout_marginTop="16dp"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipSheetColors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:singleSelection="true"
            app:selectionRequired="true"/>

        <TextView
            android:id="@+id/tvSheetSizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_size"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="15sp"
            android:visibility="gone"
            android:layout_marginTop="10dp"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipSheetSizes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:singleSelection="true"
            app:selectionRequired="true"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/quantity"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/btnSheetReduce"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="@string/reduce_char"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="20sp"
                android:gravity="center"
                android:background="@drawable/bg_arrow_back"/>

            <TextView
                android:id="@+id/tvSheetCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40dp"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/main_color"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <TextView
                android:id="@+id/btnSheetIncrease"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="@string/increase_char"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="20sp"
                android:gravity="center"
                android:background="@drawable/bg_arrow_back"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnSheetAdd"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/add_to_basket_confirm"
            android:textColor="@color/white"
            android:layout_marginTop="20dp"
            app:backgroundTint="@null"
            android:background="@drawable/bg_auth_button"/>

    </LinearLayout>

</ScrollView>
