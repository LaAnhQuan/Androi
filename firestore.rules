rules_version = '2';

// Security Rules cho Shopping App
// Dán toàn bộ nội dung file này vào:
//   Firebase Console -> Firestore Database -> Rules -> (dán) -> Publish

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper functions ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(uid()));
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.role;
    }

    function isAdmin() {
      return isSignedIn() && userDocExists() && userRole() == 'admin';
    }

    function isSellerOrAdmin() {
      return isSignedIn() && userDocExists()
        && (userRole() == 'seller' || userRole() == 'admin');
    }

    // ---------- USERS ----------
    match /users/{userId} {
      // Chỉ chính chủ hoặc admin được đọc hồ sơ
      allow read: if isSignedIn() && (uid() == userId || isAdmin());

      // Tạo hồ sơ của chính mình khi đăng ký
      allow create: if isSignedIn() && uid() == userId;

      // Admin sửa được mọi user; user thường chỉ sửa hồ sơ MÌNH và
      // KHÔNG được tự đổi role (chống tự phong admin)
      allow update: if isAdmin()
        || (isSignedIn() && uid() == userId
            && request.resource.data.role == resource.data.role);

      // Chỉ admin được xóa user
      allow delete: if isAdmin();
    }

    // ---------- PRODUCTS ----------
    match /products/{productId} {
      // Ai cũng xem được sản phẩm (kể cả chưa đăng nhập)
      allow read: if true;

      // Chỉ seller/admin đăng sản phẩm, và phải gắn đúng sellerId = mình
      allow create: if isSellerOrAdmin()
        && request.resource.data.sellerId == uid();

      // Sửa/xóa: admin hoặc chính chủ sản phẩm
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.sellerId == uid());

      // Update: admin / chủ sản phẩm sửa mọi thứ;
      // người mua chỉ được thay đổi DUY NHẤT field "stock" (giảm tồn kho khi mua)
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.sellerId == uid())
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
    }

    // ---------- CATEGORIES (danh mục) ----------
    match /categories/{categoryId} {
      allow read: if true;                 // ai cũng xem danh mục
      allow write: if isSellerOrAdmin();    // seller/admin quản lý danh mục
    }

    // ---------- BANNERS ----------
    match /banners/{bannerId} {
      allow read: if true;         // ai cũng xem banner
      allow write: if isAdmin();   // chỉ admin quản lý banner
    }

    // ---------- VOUCHERS (mã giảm giá) ----------
    match /vouchers/{code} {
      allow read: if isSignedIn();   // đăng nhập để áp mã
      allow write: if isAdmin();     // chỉ admin tạo/sửa mã
    }

    // ---------- REVIEWS (đánh giá / bình luận) ----------
    match /reviews/{reviewId} {
      allow read: if true;         // ai cũng xem đánh giá
      // đăng nhập mới được viết, và userId phải là chính mình
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      // sửa/xóa đánh giá của mình; admin toàn quyền
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == uid());
    }

    // ---------- BASKET (giỏ hàng): basket/{userId}/products/{productId} ----------
    match /basket/{userId}/products/{productId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    // ---------- ORDERS (đơn hàng) ----------
    match /orders/{orderId} {
      // Xem: admin xem tất cả; người mua xem đơn của mình;
      //      seller xem đơn có chứa sản phẩm của shop mình (uid nằm trong sellerIds)
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.buyerId == uid())
        || (isSignedIn() && resource.data.sellerIds != null
            && uid() in resource.data.sellerIds);

      // Tạo đơn: phải là đơn của chính mình
      allow create: if isSignedIn() && request.resource.data.buyerId == uid();

      // Cập nhật: admin toàn quyền; seller có sản phẩm trong đơn được đổi
      // DUY NHẤT field "status" (trạng thái giao hàng)
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.sellerIds != null
            && uid() in resource.data.sellerIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));

      // Xóa đơn: chỉ admin
      allow delete: if isAdmin();
    }

    // ---------- CHATS + MESSAGES ----------
    match /chats/{chatId} {
      // Chỉ người trong hội thoại được đọc/tạo/cập nhật
      allow read:   if isSignedIn() && uid() in resource.data.participants;
      allow create: if isSignedIn() && uid() in request.resource.data.participants;
      allow update: if isSignedIn() && uid() in resource.data.participants;

      match /messages/{messageId} {
        // Đọc tin: phải là người trong hội thoại
        allow read: if isSignedIn()
          && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Gửi tin: là người trong hội thoại và senderId = chính mình
        allow create: if isSignedIn()
          && request.resource.data.senderId == uid()
          && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // ---------- NOTIFICATIONS ----------
    match /notifications/{notifId} {
      // Chỉ người nhận (userId) hoặc admin được đọc
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == uid());
      // Người đăng nhập được tạo thông báo gửi cho người khác (tin nhắn / đơn hàng)
      allow create: if isSignedIn();
      // Người nhận sửa (đánh dấu đã đọc) / xóa thông báo của mình; admin toàn quyền
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == uid());
    }

    // ---------- STATUS (online / last seen) ----------
    match /status/{userId} {
      // Ai đăng nhập cũng đọc được (để biết đối phương online)
      allow read: if isSignedIn();
      // Mỗi người chỉ ghi trạng thái của CHÍNH mình
      allow write: if isSignedIn() && uid() == userId;
    }

    // Mọi thứ khác: chặn
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
